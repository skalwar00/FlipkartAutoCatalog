# Frontend environment variables
# Copy this file to .env.local for local development

# Port the Vite dev server listens on
PORT=25993

# Base path for the app (use "/" for root, or "/app" for a subpath)
BASE_PATH=/

# API base URL (used when calling the backend in production)
# Set this to your Railway backend URL in Vercel environment settings
VITE_API_BASE_URL=VITE_API_BASE_URL=https://flipkartautocatalog.onrender.com